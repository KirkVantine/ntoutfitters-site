---
import { site, mailto } from '../data/site';

interface Props {
  title: string;
  /** Set on the home page so the tab reads "N&T Outfitters" and not "Home | ...". */
  titleTemplate?: boolean;
  description?: string;
  /** Path to the image used for link previews. Falls back to the hero shot. */
  image?: string;
}

const {
  title,
  titleTemplate = true,
  description = `Guided fishing charters across Michigan with ${site.captain} — bass on Lake St. Clair, walleye on the Detroit River, and family trips for every skill level.`,
  image = '/images/hero-2.jpg',
} = Astro.props;

const pageTitle = titleTemplate ? `${title} | ${site.name}` : title;

// Social preview images must be absolute URLs.
const ogImage = new URL(image, Astro.site ?? Astro.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// Highlight the nav item for the page being viewed. Trailing slashes vary
// between dev and the built output, so normalise before comparing.
const trim = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const here = trim(Astro.url.pathname);
const isCurrent = (href: string) =>
  href === '/' ? here === '/' : here === trim(href) || here.startsWith(trim(href) + '/');

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/charters', label: 'Charters' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/sponsorships', label: 'Sponsorships' },
];

// Helps Google show the phone number, service area, and hours in local results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  '@id': `${Astro.site ?? Astro.url.origin}#business`,
  name: site.legalName,
  alternateName: site.name,
  description,
  url: String(Astro.site ?? Astro.url.origin),
  image: ogImage,
  telephone: site.phone,
  email: site.email,
  address: { '@type': 'PostalAddress', addressRegion: 'MI', addressCountry: 'US' },
  areaServed: site.areaServed.map((a) => ({ '@type': 'Place', name: a })),
  sameAs: [site.instagram],
  employee: { '@type': 'Person', name: site.captain, jobTitle: 'Charter Captain' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14431f" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="canonical" href={canonical} />

    <!-- Self-hosted fonts, preloaded so headings don't reflow after paint. -->
    <link
      rel="preload"
      href="/fonts/barlow-condensed-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand">
          <img src="/images/logo.png" alt="" width="44" height="44" />
          <span>
            <span class="brand-title">N&amp;T Outfitters</span>
            <span class="brand-sub">Michigan Fishing Charters</span>
          </span>
        </a>

        <button
          type="button"
          class="nav-toggle"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span class="nav-toggle-bars" aria-hidden="true"></span>
          <span>Menu</span>
        </button>

        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="header-actions">
          <a class="header-phone" href={site.phoneHref}>{site.phone}</a>
          <a href="/charters" class="btn btn-primary btn-sm">Book a Trip</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <div class="footer-brand">
              <img src="/images/logo.png" alt="" width="54" height="54" />
              <strong>N&amp;T<br />Outfitters</strong>
            </div>
            <p>
              Guided fishing charters across {site.region} and beyond. Family friendly trips for
              every skill level, run by {site.captain}.
            </p>
            <div class="social-row">
              <a href={site.instagram} target="_blank" rel="noopener noreferrer">
                <span class="visually-hidden">N&amp;T Outfitters on Instagram</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
                </svg>
              </a>
              <a href={site.phoneHref}>
                <span class="visually-hidden">Call {site.phone}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path
                    d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"
                  ></path>
                </svg>
              </a>
              <a href={mailto('Fishing trip inquiry')}>
                <span class="visually-hidden">Email {site.email}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="m2 7 10 6 10-6"></path>
                </svg>
              </a>
            </div>
          </div>

          <div>
            <h4>Explore</h4>
            <ul class="footer-links">
              {navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
            </ul>
          </div>

          <div>
            <h4>Get in Touch</h4>
            <ul class="footer-links">
              <li><a href={site.phoneHref}>{site.phone}</a></li>
              <li><a href={mailto('Fishing trip inquiry')}>{site.email}</a></li>
              <li>
                <a href={site.instagram} target="_blank" rel="noopener noreferrer">
                  {site.instagramHandle}
                </a>
              </li>
            </ul>
            <p style="margin-top:1rem">
              Booking for the {new Date().getFullYear()} season. Call or text for open dates.
            </p>
          </div>
        </div>

        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} {site.legalName}. All rights reserved.</span>
          <span>Guided charters across {site.region} &middot; Call or text for open dates</span>
        </div>
      </div>
    </footer>

    <!-- Phone-only action bar. Charter inquiries almost always start with a
         call, so it stays within thumb reach on every page. -->
    <div class="mobile-cta">
      <a class="btn btn-secondary" href={site.phoneHref}>Call Now</a>
      <a class="btn btn-primary" href="/charters">Book a Trip</a>
    </div>

    <style is:global>
      @import '../styles/global.css';
    </style>

    <script>
      // Mobile menu. The nav is visible by default and only collapses once
      // this runs, so it stays usable if the script fails to load.
      const header = document.querySelector('.site-header');
      const toggle = document.querySelector('[data-nav-toggle]');

      if (header instanceof HTMLElement && toggle) {
        header.dataset.navReady = 'true';

        const setOpen = (open: boolean) => {
          header.dataset.navOpen = String(open);
          toggle.setAttribute('aria-expanded', String(open));
        };

        setOpen(false);

        toggle.addEventListener('click', () => setOpen(header.dataset.navOpen !== 'true'));

        // Close after following a link, and on Escape.
        header.querySelectorAll('.site-nav a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && header.dataset.navOpen === 'true') {
            setOpen(false);
            (toggle as HTMLElement).focus();
          }
        });

        // If the window grows to desktop width, drop the open state so the
        // menu doesn't stay stuck open when it reflows to one line.
        window
          .matchMedia('(min-width: 901px)')
          .addEventListener('change', (e) => {
            if (e.matches) setOpen(false);
          });
      }
    </script>
  </body>
</html>
