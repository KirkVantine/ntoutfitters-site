---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title="Page Not Found" description="That page doesn't exist on this site.">
  <section class="page-hero">
    <div class="page-hero-media">
      <img src="/images/boat-running.jpg" alt="" />
    </div>
    <div class="wrap">
      <p class="eyebrow eyebrow-light">404</p>
      <h1>That One Got Away</h1>
      <p>The page you're looking for isn't here. Let's get you back on the water.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow">
      <div class="btn-row">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/charters" class="btn btn-outline">Book a Trip</a>
        <a href={site.phoneHref} class="btn btn-outline">Call {site.phone}</a>
      </div>
    </div>
  </section>
</Layout>
