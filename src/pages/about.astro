---
import Layout from '../layouts/Layout.astro';
import { site, socials, mailto } from '../data/site';
import SocialLinks from '../components/SocialLinks.astro';

// Confirmed by Nathaniel, Sep 2026. The "2075 PRO-V BASS" and LUND decals are
// legible in public/images/boat-profile.jpg.
const boat = [
  { label: 'Boat', value: '2025 Lund 2075 Pro-V Bass XS' },
  { label: 'Power', value: 'Mercury 250 Pro XS' },
  { label: 'Electronics', value: 'Three large-screen Lowrance fish finders' },
  { label: 'Trolling motor', value: 'Bow-mount, with shallow-water anchors' },
  { label: 'Capacity', value: 'Up to 4 guests plus the captain' },
];

// Standalone Person entity, linked to the business. This is what lets a
// search for "Nathaniel TerBush" resolve to him rather than just to the
// company name.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.captainName,
  jobTitle: 'Charter Captain',
  description: `Owner and guide of ${site.legalName}, running guided bass and walleye charters across ${site.region}.`,
  image: new URL('/images/captain.jpg', Astro.site ?? Astro.url).href,
  telephone: site.phone,
  email: site.email,
  sameAs: socials.map((s) => s.url),
  worksFor: {
    '@type': 'Organization',
    name: site.legalName,
    url: String(Astro.site ?? Astro.url.origin),
  },
};
---

{/* Person markup so a search for his name surfaces this page directly. */}
<Layout
  title={`About ${site.captain}`}
  description={`Meet ${site.captain} of N&T Outfitters — guided bass and walleye fishing charters across Lake St. Clair, the Detroit River, and Michigan.`}
  image="/images/captain.jpg"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personLd)} />
  <section class="page-hero">
    <div class="page-hero-media">
      <img src="/images/boat-running.jpg" alt="" />
    </div>
    <div class="wrap">
      <p class="eyebrow eyebrow-light">About</p>
      <h1>Meet Captain Nathaniel TerBush</h1>
      <p>
        Owner and guide, N&amp;T Outfitters LLC &middot; {site.region}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="split">
        <div class="split-media">
          <img
            src="/images/captain.jpg"
            alt={`${site.captain} aboard his boat`}
            loading="lazy"
          />
        </div>
        <div class="prose">
          <p class="eyebrow">Your Guide</p>
          <h2>Nathaniel TerBush</h2>
          <p class="lead">
            Welcome to N&amp;T Outfitters. I'm Nathaniel TerBush, and I've been fishing my whole
            life.
          </p>
          <p>
            I'm passionate about the outdoors and love sharing that enthusiasm with my clients as
            we chase the fish of their dreams. Let's make some unforgettable memories on the
            water.
          </p>
          <p>
            Trips run across {site.region} and up north — Lake St. Clair and Saginaw Bay for
            smallmouth, the Detroit River for walleye, and the Huron River Chain of Lakes when
            the big water is blown out. Every trip is family friendly and open to anglers of any
            experience level.
          </p>
          <div class="btn-row">
            <a href="/charters" class="btn btn-primary">See Trips &amp; Rates</a>
            <a href={site.phoneHref} class="btn btn-outline">Call {site.phone}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <div class="split">
        <div class="prose">
          <p class="eyebrow">The Rig</p>
          <h2>What You'll Fish From</h2>
          <p>
            A 2025 Lund 2075 Pro-V Bass XS with a 250 horsepower Mercury Pro XS on the back.
            Three large-screen fish finders take the guesswork out of locating fish, and there
            is room for four guests to fish comfortably without crowding each other.
          </p>
          {
            boat.length > 0 && (
              <ul class="trip-facts" style="margin-top:1.5rem;border-top:none;padding-top:0">
                {boat.map((row) => (
                  <li>
                    <span class="trip-fact-label">{row.label}</span>
                    <span class="trip-fact-value">{row.value}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="split-media">
          <img
            src="/images/boat-profile.jpg"
            alt="The 2025 Lund 2075 Pro-V Bass XS on the water"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow">
      <div class="section-head section-head-center">
        <p class="eyebrow">Contact</p>
        <h2>Let's Connect</h2>
        <p class="lead">
          I'm always looking for new and exciting opportunities — trips, sponsorships, or just
          talking fishing.
        </p>
      </div>

      <ul class="contact-lines">
        <li>Phone &amp; text &mdash; <a href={site.phoneHref}>{site.phone}</a></li>
        <li>Email &mdash; <a href={mailto('Hello from the website')}>{site.email}</a></li>
        <SocialLinks variant="list" />
      </ul>

      <div class="btn-row">
        <a href={site.phoneHref} class="btn btn-primary">Call or Text</a>
        <a href={mailto('Hello from the website')} class="btn btn-outline">Send an Email</a>
      </div>
    </div>
  </section>
</Layout>
